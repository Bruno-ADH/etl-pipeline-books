# ============================================================
# CONFIGURATION GLOBALE DU PIPELINE ETL
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- AIRFLOW ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123

# --- POSTGRESQL (metadata Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MINIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Buckets
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- SOURCES DE DONNÉES ---
# Web scraping
BOOKS_URL=https://books.toscrape.com/
BOOKS_MAX_PAGES=50

# Fichier CSV
CSV_FILE_PATH=/opt/airflow/data/Books.csv

# API Open-Meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CITIES=Paris,Montreal,Cotonou,New York,London

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=json
